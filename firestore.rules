rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles - users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User progress and spaced repetition - users can only read and write their own progress
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
